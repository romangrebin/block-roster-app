NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, never NEXT_PUBLIC. Used for DB writes so RLS
# doesn't block server-side operations (ownership/authorization enforced at the API
# route layer instead — see lib/auth.ts and notes/system-architecture.md).
# Find it in Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed onto /admin (see lib/admin.ts). Not a real role system —
# deliberately just an allowlist, this is a one-person tool for now.
ADMIN_EMAILS=you@example.com

# Steward-notification emails (lib/email.ts) — new resident registrations, sent via Resend's
# HTTP API. The same Resend account/API key and verified domain already used for Supabase Auth's
# SMTP (see notes/scaffold-status.md's Infra section) — RESEND_API_KEY just isn't otherwise
# exposed to this app's own server code, since that setup lives entirely inside Supabase's
# dashboard. Both optional: notifications are silently skipped (never block registration itself)
# if either is unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
# This app's own public base URL — used server-side (no browser, so no window.location) to build
# a link back to the community's page in notification emails. Omit to send the email without a
# link rather than guess wrong.
SITE_URL=https://yourdomain.com

# CARTO basemap API key (see lib/mapStyle.ts). Required as of Aug 2026 — without it, map tiles
# render with an "API KEY REQUIRED" watermark instead of failing outright, which is easy to miss.
# Free tier (5M tiles/month), self-serve at https://carto.com/basemaps/apikey/ . Safe to expose
# (domain-restricted in the CARTO dashboard, same key shared with geographic-community-webapp —
# registered for ourblock.community, geographic.community, and localhost).
NEXT_PUBLIC_CARTO_API_KEY=
